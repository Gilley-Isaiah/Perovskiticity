    <bib:Article rdf:about="#item_3811">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>356</prism:volume>
                <dc:title>Chemical Physics</dc:title>
                <dc:identifier>DOI https://doi.org/10.1016/j.chemphys.2008.10.036</dc:identifier>
                <prism:number>1</prism:number>
                <dc:identifier>ISSN 0301-0104</dc:identifier>
            </bib:Journal>
