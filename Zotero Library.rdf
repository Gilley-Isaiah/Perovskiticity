    <bib:Article rdf:about="#item_8205">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>10</prism:volume>
                <dc:title>Advanced Energy Materials</dc:title>
                <dc:identifier>DOI https://doi.org/10.1002/aenm.202000364</dc:identifier>
